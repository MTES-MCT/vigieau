{
  "name": "vigieau_admin_backend",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:mail-templates": "cp -r src/mail_templates/*.hbs dist/apps/backend-admin/src/mail_templates/ && mkdir -p dist/apps/backend-admin/src/mail_templates/partials && cp -r src/mail_templates/partials/*.hbs dist/apps/backend-admin/src/mail_templates/partials/",
    "build:tippecanoe": "rm -rf tippecanoe && mkdir tippecanoe && git -C tippecanoe init && git -C tippecanoe remote add origin https://github.com/felt/tippecanoe.git && git -C tippecanoe fetch --depth 1 origin 7c80fccdc17e4f8d9f4a52d518b4845290224366 && git -C tippecanoe checkout --detach FETCH_HEAD && make -j --directory=tippecanoe/ && make install --directory=tippecanoe/ PREFIX=../tippecanoe_program && node scripts/validate-tippecanoe-install.mjs tippecanoe_program/bin && rm -rf tippecanoe/",
    "scalingo-postbuild": "npm run build && npm run build:mail-templates && npm run build:tippecanoe",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:coverage": "nyc --silent nest start --watch --max-old-space-size=4096",
    "start:debug": "nest start --debug --watch --max-old-space-size=4096",
    "start:prod": "node dist/apps/backend-admin/src/main --max-old-space-size=4096",
    "start:clock": "RUN_BUSINESS_SCHEDULED_JOBS=true node --max-old-space-size=4096 dist/apps/backend-admin/src/clock",
    "datagouv:publish-communes": "node dist/apps/backend-admin/src/scripts/publish-datagouv-communes.js",
    "datagouv:publish-historique-communes": "node dist/apps/backend-admin/src/scripts/publish-datagouv-historique-communes.js",
    "recompute:commune-statistics": "node dist/apps/backend-admin/src/scripts/recompute-commune-statistics.js",
    "zones:sandre:reconcile": "node dist/apps/backend-admin/src/scripts/reconcile-sandre-zones.js",
    "arretes:confirm-open-ended-predecessor": "node dist/apps/backend-admin/src/scripts/confirm-open-ended-predecessor.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:create": "typeorm migration:create",
    "typeorm": "typeorm-ts-node-commonjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.663.0",
    "@aws-sdk/lib-storage": "^3.663.0",
    "@nestjs-modules/mailer": "2.3.7",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "^10.55.0",
    "@sentry/profiling-node": "^10.55.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.3",
    "camelcase-keys": "^7.0.2",
    "cheerio": "1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "connect-typeorm": "^2.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "fast-xml-parser": "5.7.3",
    "handlebars": "^4.7.9",
    "helmet": "^8.0.0",
    "json-2-csv": "^5.5.5",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "nestjs-paginate": "^11.1.1",
    "nodemailer": "^9.0.3",
    "openid-client": "^5.6.1",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "pg": "^8.11.3",
    "pg-query-stream": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "snakecase-keys": "^5.5.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.5.0",
    "nyc": "^18.0.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../../../global_shared/$1",
      "^connect-typeorm$": "<rootDir>/../node_modules/connect-typeorm",
      "^nestjs-paginate$": "<rootDir>/../node_modules/nestjs-paginate",
      "^typeorm$": "<rootDir>/../node_modules/typeorm",
      "^typeorm/(.*)$": "<rootDir>/../node_modules/typeorm/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.1.0"
  },
  "overrides": {
    "undici": "6.28.0",
    "@nestjs/swagger": {
      "js-yaml": "4.3.1"
    },
    "preview-email": {
      "nodemailer": "$nodemailer",
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  }
}

<% bridge_flag = ENV["VIGIEAU_PREPROD_PUBLIC_API_BRIDGE"] %>
<% raise "VIGIEAU_PREPROD_PUBLIC_API_BRIDGE must be true or false" unless [nil, "", "false", "true"].include?(bridge_flag) %>
<% raise "VIGIEAU_PREPROD_PUBLIC_API_BRIDGE is only supported on regleau-front-preprod" if bridge_flag == "true" && ENV["APP"] != "regleau-front-preprod" %>
<%
if bridge_flag == "true"
  htpasswd = ENV["VIGIEAU_PREPROD_HTPASSWD"].to_s.strip
  unless htpasswd.match?(/\A[^:\r\n]+:\$6\$(?:rounds=\d+\$)?[A-Za-z0-9.\/]{1,16}\$[A-Za-z0-9.\/]{86}\z/)
    raise "VIGIEAU_PREPROD_HTPASSWD must contain one username and SHA-512 crypt hash."
  end
  File.open("/tmp/vigieau-preprod.htpasswd", File::WRONLY | File::CREAT | File::TRUNC, 0600) do |file|
    file.chmod(0600)
    file.puts(htpasswd)
  end
end
%>

root /app/.output/public;

<% if bridge_flag == "true" %>
location ^~ /api-vigieau/ {
  auth_basic "VigiEau preproduction";
  auth_basic_user_file /tmp/vigieau-preprod.htpasswd;
  proxy_pass https://api.vigieau.beta.ecologie.gouv.fr/api/;
  proxy_set_header Host api.vigieau.beta.ecologie.gouv.fr;
  proxy_set_header Authorization $http_authorization;
  proxy_ssl_server_name on;
  proxy_ssl_name api.vigieau.beta.ecologie.gouv.fr;
  proxy_ssl_verify on;
  proxy_ssl_verify_depth 3;
  proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
}
<% end %>

location ^~ /_nuxt/ {
    add_header Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable";
    try_files $uri =404;
}

location ^~ /workbox- {
    add_header Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable";
    try_files $uri =404;
}

location / {
  autoindex off;
  port_in_redirect off;
  expires off;
  add_header Cache-Control "public, max-age=0, s-maxage=0, must-revalidate" always;
  include mime.types;
  types {
    application/manifest+json  webmanifest;
  }
  try_files $uri $uri/ /index.html =404;
}

location /api {
  proxy_pass <%= ENV["API_URL"] %>;
}

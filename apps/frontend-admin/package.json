{
  "name": "vigieau_admin_frontend",
  "version": "1.0.0",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "cypress@15.18.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "vue-demi@0.12.5": true,
    "vue-demi@0.13.11": true,
    "vue-demi@0.14.10": true
  },
  "scripts": {
    "build": "nuxi generate && purgecss --config ./purgecss.config.js && node ../../scripts/sentry-private-sourcemaps.mjs && node ../../scripts/verify-maplibre-worker-build.mjs",
    "start": "PORT=${PORT:-3003} nuxi preview",
    "dev": "nuxi dev",
    "format": "eslint . --fix",
    "generate": "nuxt generate",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lintfix": "prettier --write --list-different . && npm run lint:js -- --fix",
    "preview": "nuxt preview",
    "postinstall": "node -e \"if (process.env.NODE_ENV !== 'production') require('child_process').execSync('nuxt prepare', {stdio: 'inherit'})\"",
    "purgecss": "purgecss --config ./purgecss.config.js",
    "test:unit": "node --test --experimental-strip-types test/*.test.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "dependencies": {
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@gouvfr/dsfr": "^1.10.1",
    "@gouvminint/vue-dsfr": "^5.19.2",
    "@pinia/nuxt": "^0.5.3",
    "@sentry/vue": "^10.55.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "chart.js": "^4.4.3",
    "chartjs-adapter-luxon": "^1.3.1",
    "deepmerge": "file:vendor/vigieau-deepmerge-4.3.1-vigieau.1.tgz",
    "focus-trap": "^7.5.2",
    "focus-trap-vue": "^4.0.2",
    "libphonenumber-js": "^1.11.7",
    "listhen": "file:vendor/vigieau-listhen-1.10.1-vigieau.1.tgz",
    "lodash.deburr": "^4.1.0",
    "luxon": "^3.4.4",
    "maplibre-gl": "6.4.1",
    "moment": "^2.31.0",
    "nuxt": "4.6.2",
    "ofetch": "^1.5.1",
    "oh-vue-icons": "1.0.0-rc3",
    "pinia": "^2.2.1",
    "vue": "3.5.44",
    "vue-chartjs": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@nuxt/test-utils": "^3.7.3",
    "@nuxt/types": "^2.17.1",
    "@nuxt/typescript-build": "^3.0.1",
    "@pinia-plugin-persistedstate/nuxt": "^1.2.0",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/user-event": "^14.4.3",
    "@testing-library/vue": "^8.1.0",
    "@types/jsdom": "^21.1.2",
    "@types/lodash.deburr": "^4.1.9",
    "@types/node": "^22.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "axios": "1.20.0",
    "cypress": "^15.18.1",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.3.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^17.9.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-vue": "^9.19.2",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "prettier": "^3.1.1",
    "sass": "^1.69.5",
    "start-server-and-test": "^2.0.0",
    "typescript": "*",
    "vite-plugin-istanbul": "^6.0.2"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "@cypress/request": {
      "qs": "6.16.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "@nuxt/devtools": "3.4.4",
    "@vue/server-renderer": "3.5.44",
    "axios": "$axios",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.3",
    "devalue@5": "5.9.4",
    "follow-redirects": "1.16.1",
    "listhen": "$listhen",
    "postcss-selector-parser": "7.1.7",
    "seroval": "1.6.12",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "vite@7": "7.3.7",
    "vite@8": "8.3.5"
  }
}

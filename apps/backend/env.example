NODE_ENV=local
PORT=3002

SENTRY_DSN=
SENTRY_ENV=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=regleau

# Use legacy-bootstrap only while no active versioned zone publication exists.
STATISTIC_CACHE_MODE=versioned
# Deploy migrations first with disabled, then switch every public API instance
# to read-write at a certified computation boundary.
STATISTIC_CACHE_ARTIFACT_MODE=disabled
# Keep disabled during the expand deployment. Once enabled, public web instances
# only preload candidates and the statcache process owns materialization/activation.
STATISTIC_CACHE_DISTRIBUTED_REFRESH_ENABLED=false
# Number of complete, live web acknowledgements required before activation.
STATISTIC_CACHE_REQUIRED_ACKS=2
# Polling interval of the dedicated statcache process.
STATISTIC_CACHE_WORKER_POLL_SECONDS=10
# Switch statistics from the technical revision to the publication-only revision.
# Enable only after every writer dual-writes publicRevision.
PUBLIC_SOURCE_REVISION_ENABLED=false
# Enable only after the admin scheduler has been deployed with the same flag;
# this prevents certification before the previous-day historic boundary is prepared.
STATISTIC_CACHE_ARTIFACT_REQUIRED=false
# Heartbeat lease used by /health/statistics for the database-backed API quorum.
STATISTIC_CACHE_INSTANCE_LEASE_SECONDS=30
# Paris civil time after which today's certified statistics are required.
STATISTIC_PUBLICATION_DEADLINE=06:00

JWT_SECRET=secret

BREVO_API_KEY=
EMAIL_NOTIFICATIONS_ENABLED=0
MATTERMOST_WEBHOOK_URL=

WEBSITE_URL=http://localhost:3000

MATOMO_API_KEY=
MATOMO_URL=
MATOMO_ID_SITE=

OLD_MATOMO_URL=
OLD_MATOMO_API_KEY=
OLD_MATOMO_ID_SITE=

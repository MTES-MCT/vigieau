{
  "name": "vigieau_frontend",
  "version": "1.0.0",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "cypress@15.18.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "vue-demi@0.13.11": true,
    "vue-demi@0.14.10": true
  },
  "scripts": {
    "build": "nuxi generate && purgecss --config ./purgecss.config.js && node ../../scripts/sentry-private-sourcemaps.mjs && node ../../scripts/verify-maplibre-worker-build.mjs",
    "start": "PORT=${PORT:-3000} nuxi preview",
    "dev": "nuxi dev",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "preview": "nuxt preview",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:e2e": "start-server-and-test dev http://localhost:3000 cy:run",
    "test:unit": "node --test --experimental-strip-types test/*.test.mjs",
    "purgecss": "purgecss --config ./purgecss.config.js",
    "postinstall": "node -e \"if (process.env.NODE_ENV !== 'production') require('child_process').execSync('nuxt prepare', {stdio: 'inherit'})\""
  },
  "dependencies": {
    "@gouvfr/dsfr": "^1.10.1",
    "@gouvminint/vue-dsfr": "^7.0.1",
    "@iconify/vue": "^4.1.2",
    "@nuxtjs/robots": "^5.2.8",
    "@nuxtjs/sitemap": "^7.2.9",
    "@pinia/nuxt": "^0.5.3",
    "@sentry/vue": "^10.55.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.3",
    "chart.js": "^4.4.0",
    "chartjs-adapter-luxon": "^1.3.1",
    "html2canvas": "^1.4.1",
    "json-2-csv": "^5.5.5",
    "listhen": "file:vendor/vigieau-listhen-1.10.1-vigieau.1.tgz",
    "luxon": "^3.4.3",
    "maplibre-gl": "6.4.1",
    "moment": "^2.31.0",
    "nuxt": "4.6.2",
    "ofetch": "^1.5.1",
    "pinia": "^2.2.1",
    "pmtiles": "^3.0.6",
    "vue": "3.5.44",
    "vue-chartjs": "^5.2.0",
    "vue-dsfr-nuxt-module": "^2.0.0",
    "vue-matomo": "^4.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@nuxt/types": "^2.16.0",
    "@nuxt/typescript-build": "^3.0.0",
    "@rushstack/eslint-patch": "^1.2.0",
    "@testing-library/jest-dom": "^6.1.1",
    "@testing-library/user-event": "^14.4.3",
    "@testing-library/vue": "^8.0.0",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vite-pwa/nuxt": "^0.10.5",
    "@vue/eslint-config-typescript": "^14.1.0",
    "@vue/tsconfig": "^0.5.0",
    "cypress": "^15.18.1",
    "esbuild": "0.28.2",
    "eslint": "^9.12.0",
    "eslint-plugin-cypress": "^4.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-vue": "^9.29.0",
    "istanbul-lib-coverage": "^3.2.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "sass": "^1.79.5",
    "sass-loader": "^16.0.0",
    "start-server-and-test": "^2.0.0",
    "typescript": "~5.6.3",
    "vite-plugin-istanbul": "^6.0.2"
  },
  "overrides": {
    "@cypress/request": {
      "qs": "6.16.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "@nuxt/devtools": "3.4.4",
    "@vue/server-renderer": "3.5.44",
    "ajv": {
      "fast-uri": "3.1.9"
    },
    "axios": "1.20.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.3",
    "devalue@5": "5.9.4",
    "follow-redirects": "1.16.1",
    "listhen": "$listhen",
    "postcss-selector-parser": "7.1.7",
    "seroval": "1.6.12",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "vite@7": "7.3.7",
    "vite@8": "8.3.5",
    "vue-dsfr-nuxt-module": {
      "@gouvminint/vue-dsfr": {
        "pnpm": "10.34.5"
      }
    }
  }
}
